---
import Masthead from "../components/Masthead.astro"
import '../style.css';

interface Props {
	title?: string;
}

const { title = "tzainten — I like coding" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="wrap">
			<Masthead />

			<slot />
		</div>

		<script src="../script.js"></script>
	</body>
</html>